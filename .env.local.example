# ---- vai para o navegador (seguro) ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ---- SO nos scripts locais. NUNCA na Vercel, NUNCA no cliente. ----
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---- entrar so com o nome de usuario ----
# O servidor usa isto para pedir a sessao ao Supabase. Nunca vai ao
# navegador. Ponha o MESMO valor aqui e na Vercel, e a mesma senha nas
# duas contas do Supabase (Authentication > Users > ... > Reset password).
ENTRAR_SENHA=
